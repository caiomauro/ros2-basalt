<?xml version="1.0"?>
<package format="3">
  <name>basalt_wrapper</name>
  <version>0.1.0</version>
  <description>Generic ROS 2 wrapper for Basalt VIO that subscribes to ROS image and IMU topics and publishes standard ROS odometry and debugging outputs.</description>
  <maintainer email="caiomauro18@gmail.com">Caio Mauro</maintainer>
  <author email="caiomauro18@gmail.com">Caio Mauro</author>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>rosgraph_msgs</depend>
  <depend>rosbag2_py</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage</depend>
  <depend>geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>opencv</depend>
  <depend>pluginlib</depend>
  <depend>rviz_common</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_cmake_copyright</test_depend>
  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_cmake_cpplint</test_depend>
  <test_depend>ament_cmake_flake8</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_pep257</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rviz plugin="${prefix}/rviz_plugins.xml"/>
  </export>
</package>
