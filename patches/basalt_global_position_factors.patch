+template <class Scalar_>
+void SqrtKeypointVioEstimator<Scalar_>::ingestGlobalPositionMeasurements() {
+  GlobalPositionMeasurement::Ptr measurement;
+  while (global_position_queue.try_pop(measurement)) {
+    if (!measurement || measurement->t_ns <= 0 ||
+        global_position_measurement_ids.count(measurement->t_ns) > 0 ||
+        !measurement->position.allFinite() ||
+        !measurement->covariance.allFinite()) {
+      continue;
+    }
+
+    int64_t best_t_ns = 0;
+    int64_t best_dt_ns = std::numeric_limits<int64_t>::max();
+    const auto consider = [&](int64_t candidate_t_ns) {
+      const int64_t dt_ns = std::llabs(candidate_t_ns - measurement->t_ns);
+      if (dt_ns < best_dt_ns) {
+        best_dt_ns = dt_ns;
+        best_t_ns = candidate_t_ns;
+      }
+    };
+    for (const auto& kv : frame_poses) consider(kv.first);
+    for (const auto& kv : frame_states) consider(kv.first);
+
+    // VPC publishes a position for an exact Basalt state. A small tolerance
+    // permits output throttling and serialization jitter without attaching a
+    // delayed global observation to an unrelated aircraft pose.
+    constexpr int64_t kMaxAssociationNs = 250000000;
+    if (best_t_ns == 0 || best_dt_ns > kMaxAssociationNs) continue;
+
+    Eigen::Matrix3d covariance = measurement->covariance;
+    covariance.diagonal() = covariance.diagonal().cwiseMax(1e-4);
+    Eigen::LDLT<Eigen::Matrix3d> ldlt(covariance);
+    if (ldlt.info() != Eigen::Success) continue;
+
+    GlobalPositionFactor factor;
+    factor.state_t_ns = best_t_ns;
+    factor.position = measurement->position.template cast<Scalar>();
+    factor.information =
+        ldlt.solve(Eigen::Matrix3d::Identity()).template cast<Scalar>();
+    if (!factor.information.allFinite()) continue;
+
+    global_position_factors.emplace_back(factor);
+    global_position_measurement_ids.emplace(measurement->t_ns);
+  }
+}
+
+template <class Scalar_>
+Scalar_ SqrtKeypointVioEstimator<Scalar_>::computeGlobalPositionError() const {
+  Scalar error = 0;
+  constexpr Scalar kHuber = Scalar(3.0);
+  for (const auto& factor : global_position_factors) {
+    Vec3 position;
+    auto state_it = frame_states.find(factor.state_t_ns);
+    auto pose_it = frame_poses.find(factor.state_t_ns);
+    if (state_it != frame_states.end()) {
+      position = state_it->second.getState().T_w_i.translation();
+    } else if (pose_it != frame_poses.end()) {
+      position = pose_it->second.getPose().translation();
+    } else {
+      continue;
+    }
+    const Vec3 residual = position - factor.position;
+    const Scalar squared = residual.dot(factor.information * residual);
+    const Scalar norm = std::sqrt(std::max(Scalar(0), squared));
+    error += norm <= kHuber ? squared
+                            : Scalar(2) * kHuber * norm - kHuber * kHuber;
+  }
+  return error;
+}
+
+template <class Scalar_>
+void SqrtKeypointVioEstimator<Scalar_>::linearizeGlobalPositionFactors(
+    const AbsOrderMap& aom, MatX& H, VecX& b, Scalar& error) const {
+  constexpr Scalar kHuber = Scalar(3.0);
+  for (const auto& factor : global_position_factors) {
+    const auto order_it = aom.abs_order_map.find(factor.state_t_ns);
+    if (order_it == aom.abs_order_map.end()) continue;
+
+    Vec3 position;
+    auto state_it = frame_states.find(factor.state_t_ns);
+    auto pose_it = frame_poses.find(factor.state_t_ns);
+    if (state_it != frame_states.end()) {
+      position = state_it->second.getState().T_w_i.translation();
+    } else if (pose_it != frame_poses.end()) {
+      position = pose_it->second.getPose().translation();
+    } else {
+      continue;
+    }
+
+    const Vec3 residual = position - factor.position;
+    const Scalar squared = residual.dot(factor.information * residual);
+    const Scalar norm = std::sqrt(std::max(Scalar(0), squared));
+    const Scalar weight = norm <= kHuber ? Scalar(1) : kHuber / norm;
+    const auto weighted_information = weight * factor.information;
+    const int idx = order_it->second.first;
+    H.template block<3, 3>(idx, idx) += weighted_information;
+    b.template segment<3>(idx) += weighted_information * residual;
+    error += norm <= kHuber ? squared
+                            : Scalar(2) * kHuber * norm - kHuber * kHuber;
+  }
+}
