Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Ground Truth Path1
        - /Ground Truth Pose1
        - /Basalt Path1
        - /Basalt Pose1
        - /Tracking Overlay1
      Splitter Ratio: 0.58
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Class: rviz_default_plugins/Grid
      Cell Size: 1
      Color: 90; 96; 104
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Ground Truth Path
      Topic:
        Value: /euroc/ground_truth_path
      Color: 32; 214; 111
      Line Width: 0.0500000007
      Buffer Length: 1
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: Ground Truth Pose
      Topic:
        Value: /euroc/ground_truth_pose
      Shape: Arrow
      Color: 46; 204; 113
      Shaft Length: 0.45
      Shaft Radius: 0.02
      Head Length: 0.12
      Head Radius: 0.05
    - Class: rviz_default_plugins/Odometry
      Enabled: false
      Name: Ground Truth Odometry
      Topic:
        Value: /euroc/ground_truth_odometry
      Shape:
        Value: Arrow
      Keep: 35
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Color: 72; 255; 168
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Basalt Path
      Topic:
        Value: /basalt/path
      Color: 255; 176; 32
      Line Width: 0.0900000036
      Buffer Length: 1
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: Basalt Pose
      Topic:
        Value: /basalt/pose
      Shape: Arrow
      Color: 255; 140; 0
      Shaft Length: 0.5
      Shaft Radius: 0.025
      Head Length: 0.14
      Head Radius: 0.055
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Basalt Odometry
      Topic:
        Value: /basalt/odometry
      Shape:
        Value: Arrow
      Keep: 35
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Color: 255; 196; 64
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Tracking Overlay
      Image Topic:
        Value: /basalt/tracking_overlay
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Tracking Image
      Image Topic:
        Value: /basalt/tracking_image
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: true
    - Class: rviz_default_plugins/PointCloud
      Enabled: false
      Name: Tracked Points
      Topic:
        Value: /basalt/tracked_points
      Style: Points
      Size (Pixels): 2
      Size (m): 0.015
      Color: 255; 236; 92
  Enabled: true
  Global Options:
    Background Color: 24; 26; 31
    Fixed Frame: basalt_world
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Pitch: 0.8
      Yaw: 0.6
